# BugTime AI — copy to .env and adjust as needed
POSTGRES_USER=bugtime
POSTGRES_PASSWORD=bugtime
POSTGRES_DB=bugtime
DATABASE_URL=postgresql+psycopg://bugtime:bugtime@postgres:5432/bugtime

REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000
DATA_DIR=/data
REPOS_DIR=/data/repos

# Indexing limits
MAX_INDEX_FILES=2000
MAX_FILE_BYTES=262144
MAX_TOTAL_INDEX_BYTES=20971520
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
API_INTERNAL_URL=http://backend:8000

# P1 execution sandbox
RUNNER_IMAGE=bugtime-pytest-runner:latest
DATA_VOLUME_NAME=bugtimeai_app_data
EXECUTION_TIMEOUT_SECONDS=120

# P3 model provider (OpenAI-compatible). Required for Generate fix.
MODEL_PROVIDER=openai
MODEL_API_KEY=
MODEL_NAME=gpt-4o-mini
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_MAX_TOKENS=4000
REPAIR_MAX_ATTEMPTS=3
REPAIR_MAX_DURATION_SECONDS=600

# P4 reranker (disabled | base | finetuned). Base model: cross-encoder/ms-marco-MiniLM-L6-v2
RERANKER_MODE=disabled
RERANKER_MODEL_PATH=
RERANKER_CANDIDATE_LIMIT=50

# P5 GitHub draft PR publishing (server-side only — never expose to frontend)
# Fine-grained PAT with Contents: Read and write + Pull requests: Read and write on selected repos
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com
GITHUB_DEFAULT_TARGET_BRANCH=main
